{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["mode", "image", "harborserver"],
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["cronjob", "webhook", "both"]
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 }
      }
    },
    "harborserver": {
      "type": "object",
      "required": ["registry"],
      "properties": {
        "registry": { "type": "string", "minLength": 1 },
        "existingSecret": { "type": "string" },
        "credentials": {
          "type": "object",
          "properties": {
            "username": { "type": "string" },
            "password": { "type": "string" }
          }
        }
      },
      "$comment": "When existingSecret is empty/absent, inline credentials must be provided (replaces the template-level `required`).",
      "if": {
        "properties": {
          "existingSecret": { "const": "" }
        }
      },
      "then": {
        "required": ["credentials"],
        "properties": {
          "credentials": {
            "type": "object",
            "required": ["username", "password"],
            "properties": {
              "username": { "type": "string", "minLength": 1 },
              "password": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
