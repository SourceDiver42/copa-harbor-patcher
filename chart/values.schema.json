{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["mode", "image", "harborserver"],
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["cronjob", "webhook", "both"]
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 }
      }
    },
    "harborserver": {
      "type": "object",
      "required": ["registry"],
      "properties": {
        "registry": { "type": "string", "minLength": 1 }
      }
    }
  }
}
